# Industry–Function Mapping (IFM) — core ontology
#
# Layers 1–3 of the semantic blueprint:
#   1. Sector   — where an activity happens   (SKOS rendering of ISIC Rev. 4)
#   2. Function — what is being done          (SKOS scheme, aligned to UN CBF / APQC PCF)
#   3. Use case — the bridge between the two  (schema:Action)
#
# Layer 4 (verifiable credentials) is deliberately NOT modelled yet. The
# extension point is documented in ../README.md § "Layer 4 — deferred"; nothing
# in this file needs to change to add it.
#
# SPDX-License-Identifier: CC-BY-4.0

@prefix ifm:    <https://didas-swiss.github.io/industry-function-graph/ontology#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<https://didas-swiss.github.io/industry-function-graph/ontology>
    a owl:Ontology ;
    dct:title "Industry–Function Mapping ontology"@en ;
    dct:description """Minimal vocabulary for mapping use cases onto an industry
sector taxonomy and a business function taxonomy, so that the same function can
be recognised across sectors and the same sector can be compared across
functions."""@en ;
    dct:creator "Daniel Saeuberli" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" .

################################################################
# Layer 1 — Sector
################################################################

ifm:Sector a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Sector"@en ;
    rdfs:comment """An economic activity class. Sectors are not invented here:
they are a local SKOS rendering of ISIC Rev. 5 (sections, divisions, classes).
skos:notation carries the official ISIC code.

Identifiers for divisions and classes deliberately omit the section letter.
Letters move between revisions - finance went K to L, education P to Q and human
health Q to R between Rev. 4 and Rev. 5 - while the division and class numbers
hold. An identifier keyed on the letter would have to be rewritten at every
revision."""@en .

ifm:naceRev21Code a owl:DatatypeProperty ;
    rdfs:label "NACE Rev. 2.1 code"@en ;
    rdfs:domain ifm:Sector ;
    rdfs:range xsd:string ;
    rdfs:comment """NACE Rev. 2.1 is the European counterpart of ISIC Rev. 5 and
identical to it at section and division level, so the code is recorded as a
literal at those two levels only. It is NOT asserted at class level, where the
two classifications diverge, nor for divisions the cross-check described in
../README.md could not cover."""@en .

################################################################
# Layer 2 — Function
################################################################

ifm:BusinessFunction a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Business function"@en ;
    rdfs:comment """A unit of work an organisation performs, defined
independently of the sector performing it. "Identity proofing" is the same
function in banking and in healthcare; only its regulatory context differs."""@en .

################################################################
# Layer 3 — Use case (the bridge)
################################################################

ifm:UseCase a owl:Class ;
    rdfs:subClassOf schema:Action ;
    rdfs:label "Use case"@en ;
    rdfs:comment """An intersection node: a concrete piece of work that a given
function performs inside a given sector. Use cases are where sector-specific
regulation meets a sector-neutral function."""@en .

ifm:appliesToSector a owl:ObjectProperty ;
    rdfs:label "applies to sector"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:Sector ;
    rdfs:comment """Link to the most specific ISIC concept that is actually
warranted. A use case that genuinely spans an entire section links to the
section, not to an arbitrary class inside it."""@en .

ifm:executesFunction a owl:ObjectProperty ;
    rdfs:label "executes function"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:BusinessFunction .

ifm:primaryFunction a owl:ObjectProperty ;
    rdfs:subPropertyOf ifm:executesFunction ;
    rdfs:label "primary function"@en ;
    rdfs:comment "The one function the use case exists to perform. Exactly one per use case."@en .

ifm:sectorHasUseCase a owl:ObjectProperty ;
    rdfs:label "sector has use case"@en ;
    owl:inverseOf ifm:appliesToSector .

ifm:functionHasUseCase a owl:ObjectProperty ;
    rdfs:label "function has use case"@en ;
    owl:inverseOf ifm:executesFunction .

################################################################
# Layer 2d - value streams
#
# A value stream is an end-to-end sequence of functions producing an outcome.
# The concept follows ArchiMate's Value Stream element: the what rather than
# the how. The catalogue is this repository's own, because no openly licensed
# one exists - APQC publishes end-to-end maps but under its own terms, and the
# SAP naming is proprietary.
#
# Streams compose functions without owning them. One function appears in several
# streams, so this is a many-to-many relation and not a hierarchy.
################################################################

ifm:ValueStream a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Value stream"@en ;
    rdfs:comment """An ordered sequence of functions delivering an outcome - procure
to pay, order to cash. Stages are reified rather than listed, so each carries its
position and its own label."""@en .

ifm:ValueStreamStage a owl:Class ;
    rdfs:label "Value stream stage"@en ;
    rdfs:comment "One step of a value stream: a position, a label and the function it exercises."@en .

ifm:hasStage a owl:ObjectProperty ;
    rdfs:label "has stage"@en ;
    rdfs:domain ifm:ValueStream ;
    rdfs:range ifm:ValueStreamStage .

ifm:inValueStream a owl:ObjectProperty ;
    rdfs:label "in value stream"@en ;
    owl:inverseOf ifm:hasStage .

ifm:position a owl:DatatypeProperty ;
    rdfs:label "position"@en ;
    rdfs:domain ifm:ValueStreamStage ;
    rdfs:range xsd:integer ;
    rdfs:comment """Where the stage sits in the sequence. Ordering only: in practice
stages overlap and some are skipped."""@en .

ifm:stageFunction a owl:ObjectProperty ;
    rdfs:label "stage function"@en ;
    rdfs:domain ifm:ValueStreamStage ;
    rdfs:range ifm:BusinessFunction .

ifm:valueStream a owl:ObjectProperty ;
    rdfs:label "value stream"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:ValueStream ;
    rdfs:comment "The end-to-end sequence this use case sits inside. Optional, and a use case may sit in more than one."@en .

################################################################
# Layer 3a - why it is worth doing, and how far it changes things
#
# Sector and function say where a use case sits. They say nothing about why
# applying a verifiable credential there is worth the effort, or whether it
# improves a process that already exists or replaces it. Both are properties
# of the use case: the same function, in the same sector, can be a paper
# substitution in one instance and a new business model in another.
################################################################

ifm:ValueDriver a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Value driver"@en ;
    rdfs:comment """What applying a verifiable credential to this use case
removes, prevents or makes possible - friction, fraud, disclosure, unreachable
counterparties. A use case usually has several, and they are not ranked."""@en .

ifm:valueDriver a owl:ObjectProperty ;
    rdfs:label "value driver"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:ValueDriver .

ifm:TransformationMode a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Transformation mode"@en ;
    rdfs:comment """How far the process changes: digitise, optimise, redesign or
enable. Exactly one per use case. The first two are usually justified by a
business case that counts steps removed; the last two are justified
strategically, and may show a weak business case until they work."""@en .

ifm:transformationMode a owl:ObjectProperty ;
    rdfs:label "transformation mode"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:TransformationMode .

ifm:ChangeMode a owl:Class ; rdfs:label "Change mode"@en .
ifm:Run    a ifm:ChangeMode ; rdfs:label "Run"@en ;
    rdfs:comment "Improving a process the organisation already has. Derived from the transformation mode."@en .
ifm:Change a ifm:ChangeMode ; rdfs:label "Change"@en ;
    rdfs:comment "Reorganising a process, or doing something that was not viable before. Derived from the transformation mode."@en .

ifm:changeMode a owl:ObjectProperty ;
    rdfs:label "change mode"@en ;
    rdfs:range ifm:ChangeMode ;
    rdfs:comment "Run or change. Derived from the transformation mode, never typed in."@en .

################################################################
# Layer 4 - credential types
#
# Credentials attach to a participation - a party in a role - so that the issuer,
# the holder and the verifier each name what they handle. A property on the use
# case itself could not express the common case where one party issues one
# credential and another checks a different one within the same use case.
#
# A credential type evidences a state, which connects this layer to the rest:
# holding the credential is what makes the state true, and states are what use
# cases compose against. Credentials explain an existing composition; they do
# not alter it.
################################################################

ifm:CredentialType a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Credential type"@en ;
    rdfs:comment """A kind of verifiable credential, not an instance of one. The
schema itself is published by the relevant ecosystem; recorded here are its
format, that ecosystem, and the state it evidences."""@en .

ifm:evidences a owl:ObjectProperty ;
    rdfs:label "evidences"@en ;
    rdfs:domain ifm:CredentialType ;
    rdfs:range ifm:State ;
    rdfs:comment "Holding this credential is what makes the state true."@en .

ifm:credentialFormat a owl:DatatypeProperty ;
    rdfs:label "credential format"@en ;
    rdfs:domain ifm:CredentialType ;
    rdfs:comment "SD-JWT VC, W3C VCDM 2.0, and so on."@en .

ifm:ecosystem a owl:DatatypeProperty ;
    rdfs:label "ecosystem"@en ;
    rdfs:domain ifm:CredentialType ;
    rdfs:comment """The governance framework whose schemas apply: swiyu, EBSI, ELM
for education and labour, UN/CEFACT for trade. Omitted where none has been chosen."""@en .

ifm:issuesCredential a owl:ObjectProperty ;
    rdfs:label "issues credential"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:range ifm:CredentialType .

ifm:presentsCredential a owl:ObjectProperty ;
    rdfs:label "presents credential"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:range ifm:CredentialType .

ifm:verifiesCredential a owl:ObjectProperty ;
    rdfs:label "verifies credential"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:range ifm:CredentialType .

################################################################
# Layer 3c - states, and why use cases compose
#
# Each use case has two ends: what must already be true for it to run, and what
# is true once it has. Both are typed against a shared state vocabulary, so the
# composition can be computed - B follows A when something A leaves true is
# something B needs.
#
# Three results come from that, and none is available from the taxonomy alone:
# the chain of use cases, the states everything needs and nothing produces, and
# pairs of use cases with identical interfaces, which are likely duplicates.
################################################################

ifm:State a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "State"@en ;
    rdfs:comment """Something that is true, or something a party holds. States are
deliberately coarse, because their purpose is to be shared: a state used by only
one use case cannot connect anything."""@en .

ifm:precondition a owl:ObjectProperty ;
    rdfs:label "precondition"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:State ;
    rdfs:comment "What must already be true. A use case with no precondition can start unaided."@en .

ifm:postcondition a owl:ObjectProperty ;
    rdfs:label "postcondition"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:State ;
    rdfs:comment "What is true afterwards. Every use case must leave at least one state behind."@en .

ifm:enables a owl:ObjectProperty ;
    rdfs:label "enables"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:UseCase ;
    rdfs:comment """Derived: this use case produces a state that the other needs.
It is computed from the interfaces and never entered by hand, so a wrong arrow
means a wrong precondition or postcondition somewhere."""@en .

################################################################
# Layer 3b - who does what, at whose cost, replacing what
#
# Credential ecosystems commonly stall for a commercial reason: the cost of
# issuing falls on one party and the benefit of verifying on another. Recording
# who bears cost and who gains value lets the graph answer who has to move first
# and what they get for it.
################################################################

ifm:TrustRole a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Trust role"@en ;
    rdfs:comment "Issuer, holder, verifier or trust anchor."@en .

ifm:Participation a owl:Class ;
    rdfs:label "Participation"@en ;
    rdfs:comment """One party playing one role in one use case. Reified so that it
can carry who pays and who benefits; a direct link from use case to role has
nowhere to put those."""@en .

ifm:participation a owl:ObjectProperty ;
    rdfs:label "participation"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:Participation .

ifm:inUseCase a owl:ObjectProperty ;
    rdfs:label "in use case"@en ;
    owl:inverseOf ifm:participation .

ifm:trustRole a owl:ObjectProperty ;
    rdfs:label "trust role"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:range ifm:TrustRole .

ifm:party a owl:DatatypeProperty ;
    rdfs:label "party"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:comment "The kind of organisation or person playing the role, not a named one."@en .

ifm:bearsCost a owl:DatatypeProperty ;
    rdfs:label "bears cost"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Whether this party carries material cost to make the use case work."@en .

ifm:gainsValue a owl:DatatypeProperty ;
    rdfs:label "gains value"@en ;
    rdfs:domain ifm:Participation ;
    rdfs:comment """direct, indirect or none. This is an editorial judgement, and
the conclusions drawn from cost/value asymmetry depend on it."""@en .

ifm:costValueAsymmetry a owl:DatatypeProperty ;
    rdfs:label "cost/value asymmetry"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range xsd:boolean ;
    rdfs:comment """True when at least one party bears cost without direct value.
Derived from the participations. Where it is false, every party that must invest
also benefits, so the use case can proceed without anyone funding or obliging
another."""@en .

ifm:ReplacedEvidence a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Replaced evidence"@en ;
    rdfs:comment """What the credential displaces: a paper document, an uncheckable
PDF, a phone call, an in-person visit. Recording it is what makes a claim of
friction reduction measurable."""@en .

ifm:replaces a owl:ObjectProperty ;
    rdfs:label "replaces"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:ReplacedEvidence .

ifm:requiresUseCase a owl:ObjectProperty ;
    rdfs:label "requires use case"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:UseCase ;
    rdfs:comment """An asserted dependency, available for cases a modeller knows
before the interfaces express them. It is validated against the interfaces: if A
requires B, something B leaves true must be something A needs, otherwise either
the assertion or the states need correcting. Prefer ifm:enables, which is
derived."""@en .

################################################################
# Use case attributes
################################################################

ifm:Scope a owl:Class ; rdfs:label "Sector scope"@en .
ifm:CrossSector    a ifm:Scope ; rdfs:label "Cross-sector"@en ;
    rdfs:comment "Reaches more than one ISIC section. Derived, not hand-maintained."@en .
ifm:SectorSpecific a ifm:Scope ; rdfs:label "Sector-specific"@en ;
    rdfs:comment "Confined to a single ISIC section. Derived, not hand-maintained."@en .

ifm:sectorScope a owl:ObjectProperty ;
    rdfs:label "sector scope"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:Scope .

ifm:Maturity a owl:Class ; rdfs:label "Maturity"@en .
ifm:Exploratory a ifm:Maturity ; rdfs:label "Exploratory"@en ;
    rdfs:comment "Identified and scoped; no worked flow in this repository yet."@en .
ifm:Modelled    a ifm:Maturity ; rdfs:label "Modelled"@en ;
    rdfs:comment "A worked trust flow exists in this repository."@en .
ifm:Live        a ifm:Maturity ; rdfs:label "Live"@en ;
    rdfs:comment "Running in production somewhere in the Swiss trust ecosystem."@en .

ifm:maturity a owl:ObjectProperty ;
    rdfs:label "maturity"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:range ifm:Maturity .

ifm:documentedBy a owl:ObjectProperty ;
    rdfs:label "documented by"@en ;
    rdfs:domain ifm:UseCase ;
    rdfs:comment "The trust flow diagram or README in this repository that works the use case out."@en .

################################################################
# Provenance of the taxonomy data itself
################################################################

ifm:codeStatus a owl:DatatypeProperty ;
    rdfs:label "code status"@en ;
    rdfs:range xsd:string ;
    rdfs:comment """How far the notation/label of a concept has been checked
against the official publication of the source classification. One of
"verified" (checked against the published classification) or "provisional"
(seeded here, to be replaced by an official extract). Never silently
upgrade a value: see ../README.md § "Provenance and honesty"."""@en .
