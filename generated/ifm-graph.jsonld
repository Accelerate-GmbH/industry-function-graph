    "stream": "https://didas-swiss.github.io/industry-function-graph/id/value-stream/",
    "stage": "https://didas-swiss.github.io/industry-function-graph/id/value-stream-stage/",
    "role": "https://didas-swiss.github.io/industry-function-graph/id/trust-role/",
    "evidence": "https://didas-swiss.github.io/industry-function-graph/id/replaced-evidence/",
