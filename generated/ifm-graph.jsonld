        "@type": "http://www.w3.org/2001/XMLSchema#boolean"
      },
      "ifm:gainsValue": {
        "@value": "direct"
      },
      "skos:scopeNote": {
        "@value": "Issues the reusable attestation. A later verification of it by another regulated institution is a separate interaction and is not modelled inside onboarding.",
        "@language": "en"
      },
      "ifm:issuesCredential": {
        "@id": "cred:kyc-attestation"
      }
    },
