    {
      "@id": "cred:eid-credential",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "Electronic identity credential",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The state-issued electronic identity, held in a wallet and presented with selective disclosure. In Switzerland the EID under the E-ID Act (BGEID) of 20 December 2024: issued by fedpol through the federal trust infrastructure (Art. 13), carrying official name, given names, date of birth, sex, place of origin, place of birth, nationality, facial image and the AHV number (Art. 15 para. 1). Art. 10 para. 1 requires that the holder be able to determine which parts of it, and which information derived from them, reach the verifier. No claim schema is recorded here: the statute states the content and this repository has not read a published schema document.",
        "@language": "en"
      },
      "ifm:substantiates": [
        {
          "@id": "cond:eid-held"
        },
        {
          "@id": "cond:identity-evidence-available"
        }
      ],
      "ifm:credentialFormat": {
        "@value": "SD-JWT VC"
      },
      "ifm:trustFramework": {
        "@value": "swiyu"
      },
      "ifm:protocolProfile": {
        "@value": "swiss-profile-issuance:1.0.0, swiss-profile-verification:1.0.0"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
    {
      "@id": "cred:kyc-attestation",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "KYC attestation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A regulated institution's statement that customer due diligence was completed, reusable by another institution. The format is recorded so the attestation can ride the same infrastructure as the electronic identity; no semantic model or trust framework has been chosen for it.",
        "@language": "en"
      },
      "ifm:substantiates": {
        "@id": "cond:kyc-attestation-held"
      },
      "ifm:credentialFormat": {
        "@value": "SD-JWT VC"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
    {
      "@id": "cred:kyc-currency-attestation",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "KYC currency attestation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A statement that the due diligence behind a KYC attestation was re-evaluated within its validity period. No semantic model or trust framework has been chosen for it.",
        "@language": "en"
      },
      "ifm:substantiates": {
        "@id": "cond:kyc-attestation-current"
      },
      "ifm:credentialFormat": {
        "@value": "SD-JWT VC"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
    {
      "@id": "cred:secondary-education-certificate",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "Upper-secondary school-leaving certificate",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A school-leaving certificate as a verifiable credential; in Switzerland the gymnasiale Maturitätszeugnis. ELM is the schema family to align with and extends the W3C data model; which version of it the European Digital Credentials infrastructure requires is not settled here, so no format version and no trust framework are recorded.",
        "@language": "en"
      },
      "ifm:substantiates": {
        "@id": "cond:secondary-education-credential-held"
      },
      "ifm:credentialFormat": {
        "@value": "W3C VCDM"
      },
      "ifm:semanticModel": {
        "@value": "European Learning Model (ELM)"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
    {
      "@id": "cred:vocational-qualification-certificate",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "Vocational qualification certificate",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A completed vocational education and training qualification as a verifiable credential; in Switzerland the eidgenössisches Fähigkeitszeugnis (EFZ). Carried here to show a second credential substantiating the same condition as the school-leaving certificate: no canonical use case changes to admit it. No schema document has been read for it.",
        "@language": "en"
      },
      "ifm:substantiates": {
        "@id": "cond:secondary-education-credential-held"
      },
      "ifm:credentialFormat": {
        "@value": "W3C VCDM"
      },
      "ifm:semanticModel": {
        "@value": "European Learning Model (ELM)"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
