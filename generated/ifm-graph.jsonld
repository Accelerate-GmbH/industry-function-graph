      },
      "ifm:bearsCost": {
        "@value": "false",
        "@type": "http://www.w3.org/2001/XMLSchema#boolean"
      },
      "ifm:gainsValue": {
        "@value": "direct"
      },
      "skos:scopeNote": {
        "@value": "Decides on the verified identity whether to open the relationship.",
        "@language": "en"
      }
    },
    {
