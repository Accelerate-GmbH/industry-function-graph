    {
      "@id": "uc:banking-kyc-onboarding",
      "@type": [
        "ifm:UseCase",
        "schema:Action"
      ],
      "schema:name": {
        "@value": "Online onboarding and KYC credential issuance",
        "@language": "en"
      },
      "schema:description": {
        "@value": "A prospective customer opens a bank account remotely. The bank identifies them against the e-ID and issues a reusable KYC attestation.",
        "@language": "en"
      },
      "ifm:appliesToSector": [
        {
          "@id": "sector:ISIC-6419"
        },
        {
          "@id": "sector:ISIC-6512"
        }
      ],
      "ifm:primaryFunction": {
        "@id": "func:customer-onboarding"
      },
      "ifm:executesFunction": [
        {
          "@id": "func:identity-proofing"
        },
        {
          "@id": "func:regulatory-compliance"
        }
      ],
      "ifm:sectorScope": {
        "@id": "ifm:SectorSpecific"
      },
      "ifm:participation": [
        {
          "@id": "part:banking-kyc-onboarding-issuer"
        },
        {
          "@id": "part:banking-kyc-onboarding-holder"
        },
        {
          "@id": "part:banking-kyc-onboarding-verifier"
        }
      ],
      "ifm:replaces": [
        {
          "@id": "evidence:in-person-check"
        },
        {
          "@id": "evidence:notarised-copy"
        }
      ],
      "ifm:precondition": {
        "@id": "state:eid-held"
      },
      "ifm:postcondition": [
        {
          "@id": "state:kyc-attestation-held"
