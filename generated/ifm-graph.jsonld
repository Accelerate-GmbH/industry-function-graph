      },
      "skos:altLabel": [
        {
          "@value": "customer onboarding",
          "@language": "en"
        },
        {
          "@value": "client onboarding",
          "@language": "en"
        },
        {
          "@value": "admission",
          "@language": "en"
        }
      ],
      "skos:definition": {
        "@value": "Establishing a new relationship between an organisation and a counterparty - customer, member, student, patient or supplier - including the due diligence attached to it.",
        "@language": "en"
      },
      "skos:relatedMatch": [
        {
          "@id": "cbf:CBF-SUP-MKT"
        },
        {
          "@id": "apqc:apqc-3.0"
        }
      ],
      "ifm:mappingStatus": {
        "@value": "editorial"
      },
      "skos:editorialNote": [
        {
          "@value": "CBF's marketing and sales category is the closest fit for a commercial relationship; it does not cover admission to a school or enrolment with a public body, which this function also spans.",
          "@language": "en"
        },
        {
          "@value": "APQC's category is commercial (\"Market and Sell Products and Services\"). Recorded as the external commercial reading of this function, not as its definition.",
          "@language": "en"
        }
      ]
    },
