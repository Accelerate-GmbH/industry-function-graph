  "@graph": [
    {
      "@id": "https://didas-swiss.github.io/industry-function-graph/",
      "@type": [
        "owl:Ontology"
      ],
      "owl:imports": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/ontology"
      },
      "dct:title": {
        "@value": "Industry-Function Mapping graph",
        "@language": "en"
      },
      "dct:creator": {
        "@value": "Daniel Saeuberli"
      },
      "dct:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    },
    {
      "@id": "scheme:isic-rev5",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "ISIC Rev. 5 (sectors used by this repository)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Local SKOS rendering of the International Standard Industrial Classification of All Economic Activities, Revision 5. All 22 sections, plus the divisions and classes the mapped use cases actually reach. ISIC is the primary scheme here. It agrees with NOGA 2025 at section and division level: checked against the NOGA subset codified in the DIDAS Trust Flow Diagram Repository, all 22 section letters and all 23 of its divisions agree, with three section titles differing in spelling only. A division number is therefore a usable join key between this graph and a NOGA-classified sector. The agreement does not extend below division level.",
        "@language": "en"
      },
      "ifm:schemeVersion": {
        "@value": "Rev. 5"
      },
      "dct:source": {
        "@id": "https://unstats.un.org/unsd/classifications/Econ/isic"
      }
    },
    {
      "@id": "scheme:cbf",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Classification of Business Functions (categories)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Business function categories following the UNECE/Eurostat Classification of Business Functions. Labels are seeded here and carry codeStatus 'provisional' until checked against the official publication; no notations are invented. Core and support in CBF are relative to the enterprise, so no IFM function is hung under either as a broader concept.",
        "@language": "en"
      },
      "ifm:schemeVersion": {
        "@value": "edition not confirmed; check against the UN Manual on the Classification of Business Functions"
      },
      "dct:source": {
        "@id": "https://unstats.un.org/unsd/classifications/Econ/Download/Manual_on_the_Classification_of_Business_Functions_WEB_2024-08-19.pdf"
      }
    },
    {
      "@id": "scheme:apqc-pcf",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "APQC Process Classification Framework (referenced categories)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Only the cross-industry PCF categories an alignment actually references. The framework itself is published by APQC and is not redistributed here. The labels carried here follow the 13-category cross-industry structure.",
        "@language": "en"
      },
      "ifm:schemeVersion": {
        "@value": "Cross-Industry, 13-category structure; the point release these labels were seeded from has not been confirmed against the APQC publication"
      },
      "dct:source": {
        "@id": "https://www.apqc.org/process-frameworks"
      }
    },
    {
      "@id": "scheme:ifm-value-drivers",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Value drivers",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Why applying a verifiable credential to a function is worth doing: what it removes, prevents or makes possible. A use case usually has several.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-transformation-modes",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Transformation modes",
        "@language": "en"
      },
      "dct:description": {
        "@value": "How far the process changes. The first two are run - improving a process that already exists. The last two are change - reorganising it, or doing something that was not viable before. A use case has exactly one.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-credential-types",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Credential types",
        "@language": "en"
      },
      "dct:description": {
        "@value": "What is actually issued as a separate artefact, held, presented and verified. A credential type provides evidence for a state, which connects this layer to the rest; the evidence may support the state without being equivalent to it. A claim inside another credential, a derived attribute or a business conclusion is not a credential type.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://www.w3.org/TR/vc-data-model-2.0/"
      }
    },
    {
      "@id": "scheme:ifm-conditions",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Conditions",
        "@language": "en"
      },
      "dct:description": {
        "@value": "What is true, or what a party holds, before and after a composable element runs. Conditions are the interface that makes use cases compose: one element's provision satisfies another's requirement, so the chain is computed rather than maintained. They form a subsumption lattice through skos:broader, so an interface can be written at the level of generality it actually needs. Evidence conditions record that evidence is available; fact, outcome and relationship conditions record what a relying party established on it.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-trust-roles",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Trust roles",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Who does what in a credential exchange: issuer, holder, verifier, relying party, trust anchor. Verifier and relying party are separate roles that often belong to the same organisation. Recorded per use case together with who bears the cost and who gains the value, which are often different parties.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-prior-evidence",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Prior evidence mechanisms",
        "@language": "en"
      },
      "dct:description": {
        "@value": "How the same assurance is obtained today without a verifiable credential: a paper document, a PDF, a phone call, a register lookup, an in-person visit. Naming the mechanism is how a friction-reduction claim becomes checkable. The entries describe mechanisms; they do not rank them.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-value-streams",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Value streams",
        "@language": "en"
      },
      "dct:description": {
        "@value": "End-to-end sequences of functions that produce an outcome for a customer or the organisation. The concept follows ArchiMate's Value Stream element, which describes the value created rather than the steps taken. The catalogue and the stage decomposition are this repository's editorial models, because no openly licensed catalogue exists; each is one modelled sequence rather than the universal one. A function appears in several streams.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://pubs.opengroup.org/architecture/archimate32-doc/"
      }
    },
    {
      "@id": "scheme:ifm-functions",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "IFM operational business functions",
        "@language": "en"
      },
      "dct:description": {
        "@value": "The function vocabulary this repository actually maps use cases onto. Deliberately its own scheme rather than a fork of CBF or APQC PCF: the alignment to those is recorded as SKOS mapping relations, so the external classifications can be swapped or corrected without touching any use case.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
