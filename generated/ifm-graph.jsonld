    {
      "@id": "cred:supplier-qualification-record",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "Supplier qualification record",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A buying organisation's own record that a supplier passed qualification, presentable to an auditor. The format follows the accreditation certificate the record is derived from; no ecosystem schema or trust framework governs an organisation's internal record.",
        "@language": "en"
      },
      "ifm:evidences": {
        "@id": "state:supplier-qualified"
      },
      "ifm:credentialFormat": {
        "@value": "W3C VCDM 2.0"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
