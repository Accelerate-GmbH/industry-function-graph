      },
      "ifm:gainsValue": {
        "@value": "none"
      },
      "skos:scopeNote": {
        "@value": "Checks the presented electronic identity.",
        "@language": "en"
      },
      "ifm:verifiesCredential": {
        "@id": "cred:eid-credential"
      }
    },
    {
