    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@vocab": "https://didas-swiss.github.io/industry-function-graph/ontology#"
  },
  "@graph": [
    {
      "@id": "https://didas-swiss.github.io/industry-function-graph/",
      "@type": [
        "owl:Ontology"
      ],
      "owl:imports": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/ontology"
      },
      "dct:title": {
        "@value": "Industry-Function Mapping graph",
        "@language": "en"
      },
      "dct:creator": {
        "@value": "Daniel Saeuberli"
      },
      "dct:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    },
    {
      "@id": "scheme:isic-rev5",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "ISIC Rev. 5 (sectors used by this repository)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Local SKOS rendering of the International Standard Industrial Classification of All Economic Activities, Revision 5. All 22 sections, plus the divisions and classes the mapped use cases actually reach. ISIC is the primary scheme here. It is de facto equivalent to NOGA 2025 at section and division level: checked against the NOGA subset codified in the DIDAS Trust Flow Diagram Repository, all 22 section letters and all 23 of its divisions agree, with three section titles differing in spelling only. A division number is therefore a usable join key between this graph and a NOGA-classified sector. The equivalence does not extend below division level.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://unstats.un.org/unsd/classifications/Econ/isic"
      }
    },
    {
      "@id": "scheme:cbf",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Classification of Business Functions (categories)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Business function categories following the UNECE/Eurostat Classification of Business Functions. Labels are seeded here and carry codeStatus 'provisional' until checked against the official publication; no notations are invented.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://unece.org/trade/statistics"
      }
    },
    {
      "@id": "scheme:apqc-pcf",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "APQC Process Classification Framework (referenced categories)",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Only the cross-industry PCF categories an alignment actually references. The framework itself is published by APQC and is not redistributed here.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://www.apqc.org/process-frameworks"
      }
    },
    {
      "@id": "scheme:ifm-value-drivers",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Value drivers",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Why applying a verifiable credential to a function is worth doing: what it removes, prevents or makes possible. A use case usually has several.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-transformation-modes",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Transformation modes",
        "@language": "en"
      },
      "dct:description": {
        "@value": "How far the process changes. The first two are run - improving a process that already exists. The last two are change - reorganising it, or doing something that was not viable before. A use case has exactly one.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-states",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "States",
        "@language": "en"
      },
      "dct:description": {
        "@value": "What is true, or what a party holds, before and after a use case runs. States are the interface that makes use cases composable: one use case's postcondition is another's precondition, so the chain is computed rather than declared.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-trust-roles",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Trust roles",
        "@language": "en"
      },
      "dct:description": {
        "@value": "Who does what in a credential exchange: issuer, holder, verifier, trust anchor. Recorded per use case together with who bears the cost and who gets the value, because those are rarely the same party.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-replaced-evidence",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Replaced evidence",
        "@language": "en"
      },
      "dct:description": {
        "@value": "What the credential displaces: a paper document, an uncheckable PDF, a phone call, an in-person visit. Without this, friction reduction is an assertion with nothing behind it.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
    {
      "@id": "scheme:ifm-value-streams",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "Value streams",
        "@language": "en"
      },
      "dct:description": {
        "@value": "End-to-end sequences of functions that produce an outcome for a customer or the organisation. The concept follows ArchiMate's Value Stream element - the what rather than the how - and the catalogue is this repository's own, because no openly licensed one exists. A function appears in several streams.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://pubs.opengroup.org/architecture/archimate32-doc/"
      }
    },
    {
      "@id": "scheme:ifm-functions",
      "@type": [
        "skos:ConceptScheme"
      ],
      "dct:title": {
        "@value": "IFM operational business functions",
        "@language": "en"
      },
      "dct:description": {
        "@value": "The function vocabulary this repository actually maps use cases onto. Deliberately its own scheme rather than a fork of CBF or APQC PCF: the alignment to those is recorded as SKOS mapping relations, so the external classifications can be swapped or corrected without touching any use case.",
        "@language": "en"
      },
      "dct:source": {
        "@id": "https://didas-swiss.github.io/industry-function-graph/"
      }
    },
