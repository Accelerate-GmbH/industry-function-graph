    {
      "@id": "cond:identity-evidence-available",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Identity evidence available",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Evidence of who the subject is can be presented to a relying party and checked by it. Says nothing about which credential carries the evidence, or that anyone has checked it yet.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "cond:eid-held"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:eid-credential"
      }
    },
    {
      "@id": "cond:eid-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Electronic identity held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds a government-issued electronic identity credential.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "cond:identity-evidence-available"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:eid-credential"
      }
    },
    {
      "@id": "cond:education-qualification-evidence-available",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Education qualification evidence available",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Evidence of a completed education or training qualification can be presented and checked. Deliberately broader than any one certificate, so that a flow requiring it can be served by several kinds of qualification.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "cond:secondary-education-credential-held"
      }
    },
    {
      "@id": "cond:secondary-education-credential-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Upper-secondary qualification held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds a verifiable upper-secondary qualification. In Switzerland that is the gymnasiale Maturität or a federal vocational certificate (EFZ); both sit at this level.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "cond:education-qualification-evidence-available"
      },
      "ifm:substantiatedBy": [
        {
          "@id": "cred:secondary-education-certificate"
        },
        {
          "@id": "cred:vocational-qualification-certificate"
        }
      ]
    },
    {
      "@id": "cond:due-diligence-evidence-available",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Due diligence evidence available",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Evidence that customer due diligence was carried out can be presented and checked.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "cond:kyc-attestation-held"
      }
    },
    {
      "@id": "cond:kyc-attestation-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "KYC attestation held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds a reusable attestation that customer due diligence was completed.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "cond:due-diligence-evidence-available"
      },
      "skos:narrower": {
        "@id": "cond:kyc-attestation-current"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:kyc-attestation"
      }
    },
    {
      "@id": "cond:kyc-attestation-current",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "KYC attestation current",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The due diligence behind the attestation has been re-evaluated within its validity period.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "cond:kyc-attestation-held"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:kyc-currency-attestation"
      }
    },
    {
      "@id": "cond:accreditation-evidence-available",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Accreditation evidence available",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Evidence that an organisation meets a published standard can be presented and checked - a quality, conformity or sector accreditation.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "cond:supplier-accreditation-held"
      }
    },
    {
      "@id": "cond:supplier-accreditation-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Supplier accreditation held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The supplier holds current quality, conformity or sector accreditations in verifiable form.",
        "@language": "en"
      },
      "skos:broader": {
        "@id": "cond:accreditation-evidence-available"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:quality-accreditation-certificate"
      }
    },
    {
      "@id": "cond:employment-evidence-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Employment evidence held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds verifiable evidence that an employment relationship is in force.",
        "@language": "en"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:employment-attestation"
      }
    },
    {
      "@id": "cond:tertiary-enrolment-evidence-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Tertiary enrolment evidence held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds verifiable evidence of enrolment at a higher education institution.",
        "@language": "en"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:tertiary-enrolment-attestation"
      }
    },
    {
      "@id": "cond:service-entitlement-evidence-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Service entitlement evidence held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject holds verifiable evidence of entitlement to a named public service.",
        "@language": "en"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:service-entitlement-attestation"
      }
    },
    {
      "@id": "cond:supplier-qualification-evidence-held",
      "@type": [
        "ifm:EvidenceCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Supplier qualification evidence held",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The buying organisation holds a verifiable record of its own qualification decision.",
        "@language": "en"
      },
      "ifm:substantiatedBy": {
        "@id": "cred:supplier-qualification-record"
      }
    },
    {
      "@id": "cond:identity-verified",
      "@type": [
        "ifm:FactCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Identity verified",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The relying party has established that the subject is who they claim to be to a stated level of assurance.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:qualification-verified",
      "@type": [
        "ifm:FactCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Qualification verified",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The relying party has established that the subject holds the qualification the interaction requires.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:accreditation-verified",
      "@type": [
        "ifm:FactCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Accreditation verified",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The relying party has established that the organisation's accreditations are genuine and current.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:age-attribute-proven",
      "@type": [
        "ifm:FactCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Age attribute proven",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A threshold age has been demonstrated to the relying party without disclosing identity. An established fact about an interaction, not something a separate credential attests.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:legal-capacity-established",
      "@type": [
        "ifm:FactCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Legal capacity established",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The relying party has established that the subject may contract in their own right. Reached from verified attributes rather than from a credential issued for the purpose.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:customer-relationship-open",
      "@type": [
        "ifm:RelationshipCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Customer relationship open",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A contractual relationship exists between the subject and the organisation.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:employment-relationship-open",
      "@type": [
        "ifm:RelationshipCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Employment relationship open",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An employment contract is in force between the subject and an employer.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:tertiary-enrolment-established",
      "@type": [
        "ifm:RelationshipCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Tertiary enrolment established",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject is enrolled at a higher education institution.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:access-granted",
      "@type": [
        "ifm:RelationshipCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Access granted",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject can reach the service or premises the relationship entitles them to.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:service-entitlement-established",
      "@type": [
        "ifm:RelationshipCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Service entitlement established",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The body providing a public service has accepted that the subject is entitled to it.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:supplier-qualified",
      "@type": [
        "ifm:OutcomeCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Supplier qualified",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The buying organisation has decided that the supplier is eligible to be contracted.",
        "@language": "en"
      }
    },
    {
      "@id": "cond:patient-record-linked",
      "@type": [
        "ifm:OutcomeCondition",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-conditions"
      },
      "skos:prefLabel": {
        "@value": "Patient record linked",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The clinician has bound the person in front of them to the correct medical record.",
        "@language": "en"
      }
    },
    {
      "@id": "srole:subject",
      "@type": [
        "ifm:SubjectRole",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Subject",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The natural person the condition is about. The default, and the one to leave implicit unless a use case involves more than one party the conditions could apply to.",
        "@language": "en"
      }
    },
    {
      "@id": "srole:organisation",
      "@type": [
        "ifm:SubjectRole",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Organisation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The legal entity the condition is about - a supplier being qualified",
        "@language": "en"
      }
    },
    {
      "@id": "srole:relying-party",
      "@type": [
        "ifm:SubjectRole",
        "skos:Concept"
      ],
      "skos:prefLabel": {
        "@value": "Relying party",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The party that acts on the condition rather than the party it describes. Used where a condition records something the relying party has established rather than something the subject holds.",
        "@language": "en"
      }
    },
    {
      "@id": "req:identity-verification-identity-evidence",
      "@type": [
