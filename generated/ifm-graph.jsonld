        "ifm:BusinessFunction",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-functions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-functions"
      },
      "skos:prefLabel": {
        "@value": "Identity proofing",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Establishing to a stated level of assurance that a claimed identity corresponds to a real subject.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "func:identity-lifecycle-management"
      },
      "skos:broadMatch": {
        "@id": "cbf:CBF-SUP-ADM"
      },
      "skos:relatedMatch": {
        "@id": "apqc:apqc-11.0"
      },
      "skos:editorialNote": {
        "@value": "Administrative where it is a gate on a relationship; becomes core for identity service providers.",
        "@language": "en"
      }
    },
