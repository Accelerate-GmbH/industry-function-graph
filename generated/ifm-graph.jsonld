    {
      "@id": "driver:friction-reduction",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Friction reduction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Removing steps, waiting time, re-keying or intermediaries from an exchange that already happens.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:fraud-prevention",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Fraud prevention",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Making forgery, impersonation or misrepresentation of a claim impractical rather than merely detectable after the fact.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:compliance-assurance",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Compliance assurance",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Producing evidence a supervisor or auditor will accept as a by-product of doing the work, rather than as a separate exercise.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-quality",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data quality",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Removing transcription, reconciliation and staleness errors by carrying the data in a form a machine can check.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-minimisation",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data minimisation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Proving what a counterparty is entitled to know without disclosing the rest, which often makes an exchange permissible that was not.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:reach-and-inclusion",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Reach and inclusion",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Serving counterparties who could not be served before - remote, cross-border, or without a pre-existing relationship.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:new-revenue",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "New revenue",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Making a chargeable service, a market or a pricing model possible that verifiable data is a precondition for.",
        "@language": "en"
      }
    },
    {
      "@id": "mode:digitise",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Digitise",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The process keeps its shape. A paper or PDF artefact becomes a credential, and the sequence of steps does not change.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Run"
      }
    },
    {
      "@id": "mode:optimise",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Optimise",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Steps, hand-offs or waiting are removed and the channel may change, but the process is recognisably the same one.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Run"
      }
    },
    {
      "@id": "mode:redesign",
      "@type": [
