    {
      "@id": "driver:friction-reduction",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Friction reduction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Removing steps, waiting time, re-keying or intermediaries from an exchange that already happens.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:fraud-risk-reduction",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Fraud risk reduction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Reducing selected forms of forgery, tampering, impersonation or misrepresentation through cryptographically verifiable evidence and governed trust relationships.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:compliance-assurance",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Compliance assurance",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Producing evidence a supervisor or auditor will accept as a by-product of doing the work, instead of as a separate exercise.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-quality",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data quality",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Reducing transcription, reconciliation and staleness errors, and enabling machine-verifiable provenance and freshness where the credential format and the issuer's practice support it.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-minimisation",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data minimisation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Limiting disclosure to the attributes required for a defined interaction, where the credential format and the governance model support it. Which attributes are required is a governance question, not one the format settles.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:reach-and-inclusion",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Reach and inclusion",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Serving counterparties who could not be served before - remote, cross-border, or without a pre-existing relationship.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:new-revenue",
      "@type": [
        "ifm:ValueDriver",
