      },
      "ifm:bearsCost": {
        "@value": "false",
        "@type": "http://www.w3.org/2001/XMLSchema#boolean"
      },
      "ifm:gainsValue": {
        "@value": "direct"
      },
      "ifm:holdsCredential": {
        "@id": "cred:kyc-attestation"
      },
      "ifm:presentsCredential": {
        "@id": "cred:eid-credential"
      }
