      "@id": "cred:service-entitlement-attestation",
      "@type": [
        "ifm:CredentialType",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-credential-types"
      },
      "skos:prefLabel": {
        "@value": "Service entitlement attestation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A statement that the subject is entitled to a named public service. No semantic model or trust framework has been chosen for it.",
        "@language": "en"
      },
      "ifm:substantiates": {
        "@id": "cond:service-entitlement-evidence-held"
      },
      "ifm:credentialFormat": {
        "@value": "SD-JWT VC"
      },
      "ifm:codeStatus": {
        "@value": "provisional"
      }
    },
    {
      "@id": "role:issuer",
      "@type": [
        "ifm:TrustRole",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:prefLabel": {
        "@value": "Issuer",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Makes a signed statement about a subject and is accountable for the process behind it, including the cost of being able to make it credibly.",
        "@language": "en"
      }
    },
    {
      "@id": "role:holder",
      "@type": [
        "ifm:TrustRole",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:prefLabel": {
        "@value": "Holder",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The party a credential is issued to. It keeps the credential and decides when, to whom and in what detail to present it. A holder may be a natural person, an organisation, or a system acting under an organisation's control.",
        "@language": "en"
      }
    },
    {
      "@id": "role:verifier",
      "@type": [
        "ifm:TrustRole",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:prefLabel": {
        "@value": "Verifier",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Performs the technical checks on a presented credential or presentation: signature, issuer authority, status, holder binding and freshness. It establishes whether the evidence is valid, not what should follow from it.",
        "@language": "en"
      }
    },
    {
      "@id": "role:relying-party",
      "@type": [
        "ifm:TrustRole",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:prefLabel": {
        "@value": "Relying party",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Acts on the outcome of verification to reach a business or administrative decision. Often the same organisation as the verifier, and recorded separately because the two can be separated and carry different accountability.",
        "@language": "en"
      }
    },
    {
      "@id": "role:trust-anchor",
      "@type": [
        "ifm:TrustRole",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-trust-roles"
      },
      "skos:prefLabel": {
        "@value": "Trust anchor",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Provides the authoritative trust information a verifier uses to assess other participants: which issuers exist, what they are authorised to attest, and how that changes. How that information is published is an ecosystem decision and is not implied by the role.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:friction-reduction",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Friction reduction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Removing steps, waiting time, re-keying or intermediaries from an exchange that already happens.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:fraud-risk-reduction",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Fraud risk reduction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Reducing selected forms of forgery, tampering, impersonation or misrepresentation through cryptographically verifiable evidence and governed trust relationships.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:compliance-assurance",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Compliance assurance",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Producing evidence a supervisor or auditor will accept as a by-product of doing the work, instead of as a separate exercise.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-quality",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data quality",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Reducing transcription, reconciliation and staleness errors, and enabling machine-verifiable provenance and freshness where the credential format and the issuer's practice support it.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:data-minimisation",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Data minimisation",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Limiting disclosure to the attributes required for a defined interaction, where the credential format and the governance model support it. Which attributes are required is a governance question, not one the format settles.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:reach-and-inclusion",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "Reach and inclusion",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Serving counterparties who could not be served before - remote, cross-border, or without a pre-existing relationship.",
        "@language": "en"
      }
    },
    {
      "@id": "driver:new-revenue",
      "@type": [
        "ifm:ValueDriver",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-value-drivers"
      },
      "skos:prefLabel": {
        "@value": "New revenue",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Making a chargeable service, a market or a pricing model possible that verifiable data is a precondition for.",
        "@language": "en"
      }
    },
    {
      "@id": "mode:digitise",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Digitise",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The process keeps its shape. A paper or PDF artefact becomes a credential, and the sequence of steps does not change.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Run"
      }
    },
    {
      "@id": "mode:optimise",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Optimise",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Steps, hand-offs or waiting are removed and the channel may change, but the process is recognisably the same one.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Run"
      }
    },
    {
      "@id": "mode:redesign",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Redesign",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An existing process is materially reorganised around verifiable data, including changes to roles, sequence or information custody.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Change"
      }
    },
    {
      "@id": "mode:enable",
      "@type": [
        "ifm:TransformationMode",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-transformation-modes"
      },
      "skos:prefLabel": {
        "@value": "Enable",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Enables an activity or operating model that was previously impractical or uneconomic at the required level of trust.",
        "@language": "en"
      },
      "ifm:changeMode": {
        "@id": "ifm:Change"
      }
    },
    {
      "@id": "prior:paper-document",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "Paper document",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An original or certified copy handed over, posted or presented in person.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:pdf-attachment",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "PDF or scan",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A PDF or scanned document whose authenticity is not machine-verifiable through the trust mechanism the use case relies on. A PDF may carry an electronic signature; where it does and the verifier can check it, it is not this mechanism.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:phone-or-email-check",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "Phone or email check",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A human contacting the issuing organisation to ask whether a claim is true.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:registry-lookup",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "Registry lookup",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A verifier querying an authoritative register directly. It gives current data from the source and works wherever the register exists and grants the verifier access; it requires that access, connectivity at the time of the check, and that the register learns which subject was looked up.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:in-person-check",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "In-person check",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject attending in person so a human can inspect a document or their face.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:notarised-copy",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "Notarised copy",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "A third party attesting that a copy matches an original, at a fee and a delay.",
        "@language": "en"
      }
    },
    {
      "@id": "prior:self-declaration",
      "@type": [
        "ifm:PriorEvidenceMechanism",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-prior-evidence"
      },
      "skos:prefLabel": {
        "@value": "Self-declaration",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "The subject asserting something the recipient does not check, accepted where verifying it would cost more than the assessed risk of it being false.",
        "@language": "en"
      }
    },
    {
      "@id": "prov:eid-issuance-eid",
      "ifm:satisfies": [
        {
          "@id": "req:identity-verification-identity-evidence"
        },
        {
          "@id": "req:age-threshold-verification-identity-evidence"
        }
      ]
    },
    {
      "@id": "prov:identity-verification-identity",
      "ifm:satisfies": [
        {
          "@id": "req:due-diligence-onboarding-identity"
        },
        {
          "@id": "req:credential-recovery-reidentification-identity"
        },
        {
          "@id": "req:legal-capacity-reidentification-identity"
        },
        {
          "@id": "req:education-qualification-issuance-identity"
        },
        {
          "@id": "req:tertiary-admission-identity"
        },
        {
          "@id": "req:employment-engagement-identity"
        },
        {
          "@id": "req:patient-record-matching-identity"
        },
        {
          "@id": "req:public-service-access-identity"
        }
      ]
    },
    {
      "@id": "prov:qualification-verification-qualification",
      "ifm:satisfies": [
        {
          "@id": "req:tertiary-admission-qualification"
        },
        {
          "@id": "req:employment-engagement-qualification"
        }
      ]
    },
    {
      "@id": "prov:accreditation-verification-accreditation",
      "ifm:satisfies": {
        "@id": "req:supplier-qualification-accreditation"
      }
    },
    {
      "@id": "prov:due-diligence-onboarding-relationship",
      "ifm:satisfies": [
        {
          "@id": "req:due-diligence-refresh-relationship"
        },
        {
          "@id": "req:credential-recovery-reidentification-relationship"
        },
        {
          "@id": "req:legal-capacity-reidentification-relationship"
        }
      ]
    },
    {
      "@id": "prov:due-diligence-onboarding-attestation",
      "ifm:satisfies": {
        "@id": "req:due-diligence-refresh-prior-due-diligence"
      }
    },
    {
      "@id": "prov:education-qualification-issuance-qualification-evidence",
      "ifm:satisfies": {
        "@id": "req:qualification-verification-qualification-evidence"
      }
    }
  ]
}
