    {
      "@id": "func:identity-proofing",
      "@type": [
        "ifm:BusinessFunction",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-functions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-functions"
      },
      "skos:prefLabel": {
        "@value": "Identity proofing",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "Establishing to a stated level of assurance that a claimed identity corresponds to a real subject.",
        "@language": "en"
      },
      "skos:narrower": {
        "@id": "func:identity-lifecycle-management"
      },
      "skos:relatedMatch": [
        {
          "@id": "cbf:CBF-SUP-ADM"
        },
        {
          "@id": "apqc:apqc-11.0"
        }
      ],
      "ifm:mappingStatus": {
        "@value": "editorial"
      },
      "skos:editorialNote": {
        "@value": "Administrative where it is a gate on a relationship; core for identity service providers. Related rather than broader for that reason.",
        "@language": "en"
      }
    },
    {
      "@id": "func:relationship-onboarding",
      "@type": [
        "ifm:BusinessFunction",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "scheme:ifm-functions"
      },
      "skos:topConceptOf": {
        "@id": "scheme:ifm-functions"
      },
      "skos:prefLabel": {
