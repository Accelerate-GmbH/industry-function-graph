      },
      "skos:prefLabel": {
        "@value": "Redesign",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "An existing process is reorganised around verifiable data. Roles, sequence or who holds what change, and the old process is not recoverable from the new one.",
