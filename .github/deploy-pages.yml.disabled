# SPDX-License-Identifier: MIT

# Publishes generated/ to GitHub Pages, so that the matrix, the graph and the
# ontology are fetchable under the namespace the concepts are minted in,
# https://didas-swiss.github.io/industry-function-graph/.
#
# Requires: Settings > Pages > Source = "GitHub Actions" (not "Deploy from a branch").
# That was set by hand and the workflow is green. It had to be: the configure-pages
# step asks to create the site itself (enablement: true), but this organization
# refuses the Actions token with "Create Pages site failed / Resource not
# accessible by integration". The flag is kept because it is correct where the
# token is allowed, and a no-op once the site exists - but a repository that turns
# Pages off again will need the setting restored by hand, not by this workflow.

name: Deploy Pages

on:
  push:
    branches: ["main"]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  build-pages:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v5

      - name: Setup Pages
        uses: actions/configure-pages@v4
        with:
          # creates the site on first run where org policy allows it
          enablement: true

      - name: Assemble static output
        run: |
          mkdir -p dist
          cp generated/index.html generated/ifm-graph.ttl generated/ifm-graph.jsonld dist/
          cp generated/matrix.md generated/composition-report.md dist/
          # served both at the ontology IRI itself and under a .ttl extension
          cp ontology/ifm.ttl dist/ontology
          cp ontology/ifm.ttl dist/ontology.ttl
          # the shapes exist so a consumer holding only the RDF can check it
          # without this repository, which means they have to be fetchable too
          cp ontology/ifm-shapes.ttl dist/ifm-shapes.ttl

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./dist

  deploy-pages:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build-pages
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4